# Supabase — Project Settings → API
# Both values are safe to expose to the browser: the anon key is constrained by
# Row Level Security and by the SECURITY DEFINER RPCs in
# supabase/migrations/0001_init.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Do NOT add SUPABASE_SERVICE_ROLE_KEY. The MVP does not need it, and anything
# prefixed NEXT_PUBLIC_ is bundled into client JavaScript.
