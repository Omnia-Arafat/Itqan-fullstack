# Supabase — Project Settings → API Keys
# Both values are safe to expose to the browser: the publishable key is
# constrained by Row Level Security and by the SECURITY DEFINER RPCs in
# supabase/migrations/20260804150000_init.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Do NOT add the secret key (sb_secret_…) or SUPABASE_SERVICE_ROLE_KEY. The MVP
# needs neither, and anything prefixed NEXT_PUBLIC_ is bundled into client
# JavaScript.
#
# The database password is separate again: it is only used by the Supabase CLI
# (`link` / `db push`) and never by the app. Keep it out of this file.
